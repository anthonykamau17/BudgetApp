<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.anthonykamau.budgetapp.ui.dashboard.DashboardFragment"
        android:label="Home"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>

    <fragment
        android:id="@+id/historyFragment"
        android:name="com.anthonykamau.budgetapp.ui.history.HistoryFragment"
        android:label="History"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>

    <fragment
        android:id="@+id/goalsFragment"
        android:name="com.anthonykamau.budgetapp.ui.goals.GoalsFragment"
        android:label="Goals"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>

    <fragment
        android:id="@+id/analyticsFragment"
        android:name="com.anthonykamau.budgetapp.ui.analytics.AnalyticsFragment"
        android:label="Stats"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.anthonykamau.budgetapp.ui.settings.SettingsFragment"
        android:label="Settings"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>

    <fragment
        android:id="@+id/aiCoachFragment"
        android:name="com.anthonykamau.budgetapp.ui.aicoach.AiCoachFragment"
        android:label="Money Coach"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>

    <fragment
        android:id="@+id/addExpenseFragment"
        android:name="com.anthonykamau.budgetapp.ui.addexpense.AddExpenseFragment"
        android:label="Add Expense"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right">

        <argument
            android:name="categoryName"
            app:argType="string"
            android:defaultValue="" />

    </fragment>

</navigation>