<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true">

    <com.anthonykamau.budgetapp.util.PatternBackgroundView
        android:id="@+id/pattern_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/orange_bright"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good morning,"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tv_user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brian 👋"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Main Balance Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="@drawable/gradient_card">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REMAINING BUDGET" android:textColor="#B0B0B0" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.15"/>
                    <TextView android:id="@+id/tv_remaining" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="KES 0" android:textColor="@android:color/white" android:textSize="36sp" android:textStyle="bold" android:layout_marginTop="6dp"/>
                    <ProgressBar android:id="@+id/progress_budget" style="@style/Widget.AppCompat.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="16dp" android:progressTint="@color/orange_bright" android:progressBackgroundTint="#40FFFFFF" android:max="100" android:progress="0"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                        <TextView android:id="@+id/tv_percent_remaining" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="0% remaining" android:textColor="#A0A0A0" android:textSize="11sp"/>
                        <TextView android:id="@+id/tv_budget_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Budget: KES 0" android:textColor="#A0A0A0" android:textSize="11sp"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#30FFFFFF" android:layout_marginTop="20dp" android:layout_marginBottom="20dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Spent" android:textColor="#B0B0B0" android:textSize="10sp"/>
                            <TextView android:id="@+id/tv_spent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@android:color/white" android:textSize="15sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saved" android:textColor="#B0B0B0" android:textSize="10sp"/>
                            <TextView android:id="@+id/tv_saved" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/orange_bright" android:textSize="15sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Days left" android:textColor="#B0B0B0" android:textSize="10sp"/>
                            <TextView android:id="@+id/tv_days_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/orange_dim" android:textSize="15sp" android:textStyle="bold"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily left" android:textColor="#B0B0B0" android:textSize="10sp"/>
                            <TextView android:id="@+id/tv_daily_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/blue_accent" android:textSize="15sp" android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Funny Message Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💡"
                        android:textSize="18sp"
                        android:layout_marginEnd="12dp"/>
                    <TextView
                        android:id="@+id/tv_funny_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Loading..."
                        android:textColor="@color/orange_dim"
                        android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PREDICTIVE SURVIVAL FORECAST CARD -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_forecast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/bg_card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:id="@+id/tv_forecast_emoji"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="⏳"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:background="@drawable/rounded_card_bg"
                        android:backgroundTint="@color/bg_deep"
                        android:layout_marginEnd="16dp"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_forecast_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SURVIVAL FORECAST"
                            android:textColor="@color/text_tertiary"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>
                        <TextView
                            android:id="@+id/tv_forecast_message"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculating your wallet's life expectancy..."
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Money Sensei button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_ai_coach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏯" android:textSize="24sp" android:layout_marginEnd="12dp"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Consult your Money Sensei" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Get instant offline data-driven intelligence" android:textColor="@color/text_tertiary" android:textSize="11sp" android:layout_marginTop="2dp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="→" android:textColor="@color/orange_bright" android:textSize="20sp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Quick Add Section -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick add" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">
                <LinearLayout android:id="@+id/btn_quick_food" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/rounded_card_bg" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🍔" android:textSize="22sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_quick_fare" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/rounded_card_bg" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚌" android:textSize="22sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_quick_books" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/rounded_card_bg" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📚" android:textSize="22sp"/>
                </LinearLayout>
                <LinearLayout android:id="@+id/btn_quick_coffee" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:padding="12dp" android:background="@drawable/rounded_card_bg" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☕" android:textSize="22sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Category budget limits section (unchanged) -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category limits" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_category_budgets" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:layout_marginBottom="24dp"/>

            <!-- Recent Transactions section (unchanged) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" android:letterSpacing="0.05"/>
                <TextView android:id="@+id/tv_see_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See all" android:textColor="@color/blue_accent" android:textSize="13sp" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_recent_expenses" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false"/>
            <TextView android:id="@+id/tv_empty_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No expenses yet — start tracking!" android:textColor="@color/text_tertiary" android:textSize="14sp" android:gravity="center" android:padding="32dp" android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
