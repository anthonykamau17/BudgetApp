<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/rounded_card_bg">

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="@color/orange_bright"
            android:layout_marginBottom="8dp"/>

        <!-- Greeting -->
        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good morning,"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brian 👋"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Balance Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            android:background="@drawable/gradient_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/rounded_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REMAINING BUDGET"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.1"/>

                <TextView
                    android:id="@+id/tv_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KES 0"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:letterSpacing="-0.02"/>

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/progress_budget"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="12dp"
                    android:progressTint="@color/orange_bright"
                    android:progressBackgroundTint="@color/bg_deep"
                    android:max="100"
                    android:progress="0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/rounded_card_bg">

                    <TextView
                        android:id="@+id/tv_percent_remaining"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0% remaining"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"/>

                    <TextView
                        android:id="@+id/tv_budget_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Budget: KES 0"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"/>

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border_subtle"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"/>

                <!-- 4 mini stats -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/rounded_card_bg">

                    <!-- Spent -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_card_bg">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spent"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"/>
                        <TextView
                            android:id="@+id/tv_spent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Saved -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_card_bg">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saved"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"/>
                        <TextView
                            android:id="@+id/tv_saved"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/orange_bright"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Days left -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_card_bg">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Days left"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"/>
                        <TextView
                            android:id="@+id/tv_days_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/orange_dim"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Daily left -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/rounded_card_bg">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily left"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"/>
                        <TextView
                            android:id="@+id/tv_daily_left"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/blue_accent"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Funny Message Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1C1228"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_card_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="18sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:id="@+id/tv_funny_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Loading your financial situation..."
                    android:textColor="@color/orange_dim"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Spending donut visual -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <!-- Donut chart placeholder -->
                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/circular_progress"
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_marginEnd="16dp"
                    app:indicatorColor="@color/orange_bright"
                    app:trackColor="@color/bg_deep"
                    app:indicatorSize="70dp"
                    app:trackThickness="8dp"
                    app:trackCornerRadius="4dp"
                    android:progress="0"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_spend_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spent this month"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/tv_spend_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KES 0"
                        android:textColor="@color/orange_bright"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/tv_spend_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="of KES 0 budget"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Quick Add Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick add"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:weightSum="4"
            android:background="@drawable/rounded_card_bg">

            <!-- Food -->
            <LinearLayout
                android:id="@+id/btn_quick_food"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_card_bg">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🍔" android:textSize="22sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Food" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Fare -->
            <LinearLayout
                android:id="@+id/btn_quick_fare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_card_bg">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚌" android:textSize="22sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fare" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Books -->
            <LinearLayout
                android:id="@+id/btn_quick_books"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_card_bg">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📚" android:textSize="22sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Books" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Coffee -->
            <LinearLayout
                android:id="@+id/btn_quick_coffee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/rounded_card_bg">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☕" android:textSize="22sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coffee" android:textColor="@color/text_secondary" android:textSize="10sp" android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Recent Transactions Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_card_bg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tv_see_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See all"
                android:textColor="@color/blue_accent"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <!-- Recent transactions list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_recent_expenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>

        <!-- Empty state for recent -->
        <TextView
            android:id="@+id/tv_empty_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No expenses yet — start tracking!"
            android:textColor="@color/text_tertiary"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>